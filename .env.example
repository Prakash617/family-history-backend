# Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
DATABASE_URL=postgres://family_user:family_password@localhost:5432/family_tree_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SimpleJWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis / Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# Storage: local or cloudinary
STORAGE_BACKEND=local
# Cloudinary (Optional, for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Settings (for invitations & notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@familytree.local
